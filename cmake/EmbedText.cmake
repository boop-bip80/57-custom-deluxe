# EmbedText.cmake -- turn a text file into a C++ function returning its contents.
# Chunked into <= 6000-byte raw literals so MSVC's string-literal limits are never hit.
#   cmake -DINPUT=... -DOUTPUT=... -DFUNC=... -P EmbedText.cmake
file(READ "${INPUT}" _txt)
string(LENGTH "${_txt}" _len)
set(_out "// GENERATED by cmake/EmbedText.cmake from ${INPUT} -- do not edit.\n#include <string>\nnamespace cd57 {\nstd::string ${FUNC}() {\n    static const char* const parts[] = {\n")
set(_pos 0)
while(_pos LESS _len)
    math(EXPR _rem "${_len} - ${_pos}")
    if(_rem GREATER 6000)
        set(_n 6000)
    else()
        set(_n ${_rem})
    endif()
    string(SUBSTRING "${_txt}" ${_pos} ${_n} _chunk)
    string(APPEND _out "        R\"CD57RAW(${_chunk})CD57RAW\",\n")
    math(EXPR _pos "${_pos} + ${_n}")
endwhile()
string(APPEND _out "    };\n    std::string s;\n    for (const char* p : parts) s += p;\n    return s;\n}\n} // namespace cd57\n")
file(WRITE "${OUTPUT}" "${_out}")
